{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "railatlas.bundles/1",
  "title": "RailAtlas routing bundle registry",
  "type": "object",
  "required": ["schema", "strategy", "bundles"],
  "properties": {
    "schema": {"const": "railatlas.bundles/1"},
    "strategy": {"type": "string"},
    "description": {"type": "string"},
    "build": {"type": "object"},
    "bundles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "graph", "bbox", "countries", "status", "neighbours", "portals"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "graph": {"type": "string", "minLength": 1},
          "location_index": {"type": "string"},
          "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
          "countries": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2, "maxLength": 2}},
          "version": {"type": "string"},
          "built_at": {"type": "string"},
          "status": {"enum": ["building", "routable", "degraded"]},
          "source": {"type": "object"},
          "neighbours": {"type": "array", "items": {"type": "string"}},
          "portals": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["portal_id", "node_id", "neighbour_bundle"],
              "properties": {
                "portal_id": {"type": "string"},
                "node_id": {"type": "string"},
                "neighbour_bundle": {"type": "string"},
                "source_ref": {"type": ["string", "integer"]},
                "location": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
